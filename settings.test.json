  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/xzixuan/Documents/obsidian-vault/dev/tools/cc-bridge-slack/mirror.sh user"
          }
        ]
      }
