# Copy to ~/.claude/tools/slack-bridge.env  (chmod 600)
# This file is NON-SECRET; bot token lives in macOS Keychain.
#
# After cloning this repo on a new Mac, run install.sh — it'll prompt for
# the token, store it in keychain, and create this env file from scratch.

# Your Slack user ID in the sandbox workspace (U01ABCDEFGH).
# Find it: avatar -> Profile -> ... menu -> Copy member ID
SLACK_USER_ID=U_REPLACE_ME

# Display identities
BEAR_DISPLAY_NAME="Bear"
BEAR_ICON_URL="https://ca.slack-edge.com/REPLACE_ME"
CLAUDE_DISPLAY_NAME="Claude Code"
CLAUDE_ICON_URL=""  # leave empty if you've set the app icon in Slack admin

# Behavior
MIRROR_TAG="cc"
MIRROR_DRY_RUN=0

# Optional: override paths (rarely needed)
# SLACK_BRIDGE_ENV=$HOME/.claude/tools/slack-bridge.env
# MIRROR_LOG=/tmp/cc-mirror-test.log
# MIRROR_STATE_DIR=$HOME/.claude/tools/cc-bridge-state

# Optional debug
# MIRROR_DEBUG_SURFACE=1
# MIRROR_DUMP=1
